{
  "name": "durable-runner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite web --config web/vite.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "spike:workers": "tsx server/src/worker/run-experiment.ts",
    "worker": "tsx server/src/worker/worker.ts",
    "demo:workers": "tsx server/src/worker/run-demo.ts",
    "coordinator": "tsx server/src/coordinator/coordinator.ts",
    "demo:recovery": "tsx server/src/worker/run-recovery-demo.ts",
    "demo:fencing": "tsx server/src/worker/run-fencing-demo.ts",
    "demo:retries": "tsx server/src/worker/run-retries-demo.ts",
    "demo:idempotency": "tsx server/src/worker/run-idempotency-demo.ts",
    "bench": "tsx benchmarks/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p benchmarks/tsconfig.json",
    "build:web": "vite build web --config web/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.build.json",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server/src/index.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
